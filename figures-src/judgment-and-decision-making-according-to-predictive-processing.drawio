<mxfile host="app.diagrams.net" modified="2026-08-01T00:00:00.000Z" agent="5.0" version="24.7.17" type="device"><diagram id="d1" name="Page-1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="680" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a1" value="Decision-Maker / Predictive Brain" style="rounded=1;dashed=1;dashPattern=12 8;strokeColor=#2b6cb0;fillColor=none;fontStyle=1;fontSize=18;verticalLabelPosition=top;verticalAlign=bottom;" parent="1" vertex="1"><mxGeometry x="10" y="40" width="1030" height="560" as="geometry"/></mxCell><mxCell id="a2" value="Interface with<br>the world" style="rounded=1;dashed=1;dashPattern=10 8;strokeColor=#999999;fillColor=none;fontStyle=1;fontSize=18;verticalLabelPosition=top;verticalAlign=bottom;" parent="1" vertex="1"><mxGeometry x="1080" y="40" width="180" height="560" as="geometry"/></mxCell><mxCell id="b1" value="🧠 <b>Internal model</b><br><font style="font-size:12px">Beliefs, causal assumptions,<br>desired outcomes, favored<br>action plans</font>" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2b6cb0;fillColor=#f4f8fd;fontStyle=1;fontSize=15;" parent="1" vertex="1"><mxGeometry x="100" y="95" width="360" height="120" as="geometry"/></mxCell><mxCell id="b2" value="📈 <b>Predictions</b><br><font style="font-size:12px">Expected sensations and<br>outcomes; guide sensory<br>processing and interpretation</font>" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2b6cb0;fillColor=#f4f8fd;fontStyle=1;fontSize=15;" parent="1" vertex="1"><mxGeometry x="100" y="285" width="360" height="120" as="geometry"/></mxCell><mxCell id="b3" value="⚖ <b>Precision/Attention</b><br><font style="font-size:12px">Weights influence of<br>prediction vs. sensory<br>evidence</font>" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#d97706;fillColor=#fff8ef;fontStyle=1;fontSize=15;" parent="1" vertex="1"