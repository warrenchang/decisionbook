pandoc
  to: html
  output-file: how-to-use-this-book.html
  standalone: true
  toc: true
  number-sections: false
  title-prefix: Decision in the Making
  section-divs: true
  html-math-method: mathjax
  wrap: none
  default-image-extension: png
  toc-depth: 3

metadata
  crossref:
    chapters: true
  document-css: false
  link-citations: true
  lang: en
  date-format: MMMM D, YYYY
  number-depth: 0
  editor:
    markdown:
      wrap: none
      canonical: true
  theme:
    - cosmo
    - quarto-custom.scss
  smooth-scroll: true
  code-copy: false
  minimal: true
  comments: false
  hide-description: true
  title: How to Use This Book
  description: Visible choices are only the endpoint. This book follows decisions in the making—from attention, interpretation, prediction, and valuation to influence, communication, negotiation, and the design of environments that make better judgment and action possible.

